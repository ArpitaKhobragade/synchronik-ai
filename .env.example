# ---- SynchronikAI backend configuration ----
# Copy to .env (never commit .env) and fill in the three REQUIRED values below.
# If a required value is missing, the server still starts and logs a `config_incomplete` warning that names the
# variable and what is disabled; GET /api/health also reports it.

# ---- REQUIRED ----------------------------------------------------------------------------------------------------
# Database. Local quick start: SQLite file (create the `data` folder first). Production: PostgreSQL, e.g.
#   DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/<database>
# (postgres:// and postgresql:// URLs from hosting providers are accepted and converted automatically.)
DATABASE_URL=sqlite:///./data/synchronik.db

# Google Gemini API key (https://aistudio.google.com/apikey). Leave empty to run without generation:
# answers are then the most relevant documentation excerpts, and image questions are unavailable.
GEMINI_API_KEY=

# Admin key for upload / crawl / reindex endpoints (sent as the X-Admin-Key header). Use a long random string.
# Leave empty to disable all admin endpoints.
ADMIN_API_KEY=

# ---- Server ------------------------------------------------------------------------------------------------------
ENVIRONMENT=development            # development | production (production hides /docs)
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Individual PostgreSQL variables, used only when DATABASE_URL is empty:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=synchronik_ai
# DB_USER=postgres
# DB_PASSWORD=<password>

# ---- Models ------------------------------------------------------------------------------------------------------
LLM_MODEL=gemini-3.5-flash-lite
VISION_MODEL=gemini-3.8-flash
EMBEDDING_PROVIDER=fastembed                   # fastembed (ONNX Runtime, no PyTorch) | sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_BATCH_SIZE=8                             # ingestion batch; larger = faster crawl but more RAM (32 ≈ +250 MB)
GENERAL_ANSWERS=true                           # no documentation match: general-knowledge answer (false = decline)
LOAD_CURATED_DOCS=true                         # ingest backend/knowledge/*.html (Synchronik FAQ) at startup
RERANKER=minilm                                # minilm (ms-marco MiniLM cross-encoder) | none (~1 s faster, less RAM)
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# ---- Retrieval tuning --------------------------------------------------------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
SEMANTIC_TOP_K=20
KEYWORD_TOP_K=20
HYBRID_SEMANTIC_WEIGHT=0.65
HYBRID_KEYWORD_WEIGHT=0.35
RERANK_CANDIDATES=12
RERANK_MAX_CHARS=700
RERANK_TOP_N=6
MAX_CHUNKS_PER_SECTION=0                       # section diversity in the final ranking; 0 = off (tested, not adopted)
MIN_SEMANTIC_SCORE=0.30
MIN_RERANK_SCORE=0.10                          # gate: best chunk must clear this to answer from the docs
MIN_CONTEXT_RERANK_SCORE=0.02                  # per-chunk bar for staying in the prompt
MIN_SUPPORT_CHUNKS=1
CONTEXT_MAX_CHARS=7000
HISTORY_MAX_MESSAGES=6
HISTORY_MAX_CHARS=3000

# ---- Abuse protection --------------------------------------------------------------------------------------------
MAX_DOCUMENT_MB=20
MAX_IMAGE_MB=8
RATE_LIMIT_CHAT_PER_MIN=30
RATE_LIMIT_UPLOAD_PER_MIN=10

# ---- Crawler (authorised Synchronik sources only) ----------------------------------------------------------------
CRAWL_ALLOWED_HOSTS=help.synchronik.co.in,synchronik.co.in,www.synchronik.co.in
CRAWL_USER_AGENT=SynchronikAI-DocsCrawler/2.0 (+https://synchronik.co.in)
CRAWL_MAX_PAGES=200
CRAWL_DELAY_S=1.0
CRAWL_INTERVAL_HOURS=0                         # e.g. 24 for a daily refresh; 0 disables
